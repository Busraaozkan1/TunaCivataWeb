@model IEnumerable<TunaCivataWeb.Models.Product>

@{
    Layout = "_Layout"; // Sitenin genel tasarımıyla uyumlu olması için
    ViewData["Title"] = ViewData["CategoryName"];
}

@* 5. MADDE: Genel arka plan rengi #848684 olarak sabitlendi *@
<div style="background-color: #848684; min-height: 100vh; padding-bottom: 50px;">

    @* Başlık ve alt metinlerin kesin beyaz olması için inline style *@
    <div class="container-fluid py-5" style="background: linear-gradient(135deg, #004d40 0%, #00251a 100%); margin-top: 80px;">
        <div class="container text-center py-4">
            <h1 class="display-5 fw-bold text-uppercase" style="color: white !important;">@ViewData["CategoryName"]</h1>
            <p class="opacity-75" style="color: white !important;">Tuna Cıvata & Bağlantı Elemanları Güvencesiyle</p>
        </div>
    </div>

    <div class="container my-5">
        <div class="row g-4">
            @if (Model == null || !Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="card border-0 shadow-sm p-5" style="border-radius: 20px; background-color: #ffffff;">
                        <i class="fas fa-box-open fa-4x mb-3 text-muted"></i>
                        <h4 class="text-dark fw-bold">Henüz Ürün Eklenmemiş</h4>
                        <p class="text-muted">Bu kategorideki ürünlerimiz yakında burada sergilenecektir.</p>
                        <div class="mt-4">
                            <a href="/" class="btn btn-outline-success rounded-pill px-4">Ana Sayfaya Dön</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        @* Kart yapısı *@
                        <div class="card h-100 shadow-sm border-0 product-card">
                            @* Üst kısım: Resim alanı beyaz kalıyor *@
                            <div class="product-img-wrapper p-3" style="background-color: white; border-radius: 15px 15px 0 0;">
                                <img src="@item.ImageUrl" class="img-fluid" 
                                     onerror="this.src='/img/no-image.jpg'" 
                                     alt="@item.Name"
                                     style="max-width: 100%; max-height: 100%; object-fit: contain;">
                            </div>
                            
                            @* 4. MADDE: Alt alan daha gri yapıldı (#dfdfdf) ve her şey dikeyde/yatayda ortalandı *@
                            <div class="card-body border-top d-flex flex-column" style="background-color: #dfdfdf; padding: 1.25rem; align-items: center; text-align: center;">
                                
                                @* 1. MADDE: Ürün Adı Ortalandı *@
                                <h6 class="fw-bold text-dark mb-2" style="width: 100%; text-align: center; margin-left: 0; margin-right: 0;">
                                    @item.Name
                                </h6>
                                
                                @* 2. MADDE: Ürün Açıklaması Ortalandı *@
                                <p class="text-muted small mb-3" style="font-size: 0.75rem; height: 40px; overflow: hidden; line-height: 1.2; width: 100%; text-align: center; margin-left: 0; margin-right: 0;">
                                    @item.Description
                                </p>
                                
                                @* 3. MADDE: Teklif Al Butonu Ortalandı *@
                                <div style="width: 100%; display: flex; justify-content: center; margin-top: auto;">
                                    <a href="https://wa.me/905327040095?text=@item.Name ürünü hakkında bilgi almak ve teklif istemek istiyorum." 
                                       target="_blank" class="btn btn-sm btn-success rounded-pill px-4 d-flex align-items-center justify-content-center" style="width: 90%; font-weight: 500;">
                                        <i class="fab fa-whatsapp me-2"></i>Teklif Al
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

</div>

<style>
    .row.g-4 {
        display: flex;
        flex-wrap: wrap;
    }

    .product-card {
        border-radius: 15px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.3) !important;
    }

    .product-img-wrapper {
        height: 170px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    /* WhatsApp Butonu Renkleri */
    .btn-success { background-color: #25d366; border-color: #25d366; }
    .btn-success:hover { background-color: #128c7e; border-color: #128c7e; }
</style>